{
  "name": "tenderdelta-serpapi",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('server.js',{force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx src/benchmark/adversarialEvidenceBenchmark.ts",
    "benchmark": "tsx src/benchmark/adversarialEvidenceBenchmark.ts",
    "test:benchmark": "tsx src/benchmark/adversarialEvidenceBenchmark.ts",
    "test:regression": "tsx -e \"import { runIntelligenceRegressionTests } from './src/data/testFixtures'; const r = runIntelligenceRegressionTests(); console.log('Regression passed: ' + r.passedTests + '/' + r.totalTests); if (!r.allPassed) process.exit(1);\"",
    "test:all": "tsx src/benchmark/adversarialEvidenceBenchmark.ts && npm run test:regression && npm run test:serpapi && npm run test:readiness && npm run test:ui",
    "test:serpapi": "tsx src/utils/serpApiDiscovery.test.ts",
    "benchmark:serpapi-live": "tsx scripts/serpApiLiveBenchmark.ts",
    "test:readiness": "tsx src/utils/readiness.test.ts && tsx src/utils/evidenceValidator.readiness.test.ts",
    "test:ui": "tsx src/components/ConflictDetectorView.test.tsx && tsx src/components/MethodologyView.test.tsx && tsx src/components/ShareReportModal.test.tsx",
    "test:server": "tsx scripts/serverReadiness.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@types/express": "^4.17.21"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20"
  }
}
